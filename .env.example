# GEMINI_API_KEY: Optional for external AI capabilities.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SETUP_PASSCODE: Initial administrator bootstrap passcode.
# Leave unset in preview to claim the first administrator account via the UI setup form.
ADMIN_SETUP_PASSCODE=

# DB_PATH: Optional override path for SQLite database storage.
DB_PATH=

# STORAGE_DIR: Optional override directory for uploaded documents, reference pages, and reports.
STORAGE_DIR=
